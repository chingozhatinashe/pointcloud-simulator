{
  "method": "rjmcmc",
  "likelihood": "analytical",
  "prior_config": {
    "use_complexity": true,
    "use_orthogonality": true,
    "use_min_length": true,
    "use_junction_regularity": true,
    "use_room_size": true,
    "lambda_complexity": 0.1,
    "lambda_orthogonality": 1.0,
    "min_segment_length": 0.1,
    "lambda_junction": 1.0,
    "room_area_mean": 15.0,
    "room_area_std": 8.0,
    "room_count_rate": 4.0,
    "bounding_box_min_size": 3.0,
    "bounding_box_max_size": 15.0,
    "max_bsp_depth": 4,
    "orthogonality_perturbation_sigma": 0.05
  },
  "noise_model": {
    "range_sigma": 0.02,
    "angular_sigma": 0.01,
    "outlier_rate": 0.02,
    "missing_rate": 0.05,
    "height_sigma": 0.02
  },
  "n_iterations": 3000,
  "rng_seed": 0,
  "output_dir": "experiments/results/rjmcmc_analytical",
  "n_particles": 1,
  "gibbs_interval": 5
}
